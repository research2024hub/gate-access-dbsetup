MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=gate_access
MYSQL_USER=gate_access
MYSQL_PASSWORD=replace-with-a-long-random-password
# Optional alternative to MYSQL_* (URL-encode special characters in passwords):
# DATABASE_URL=mysql+pymysql://gate_access:password@127.0.0.1:3306/gate_access?charset=utf8mb4
# Only used by the PostgreSQL data transfer command:
# SOURCE_DATABASE_URL=postgresql+psycopg2://user:password@host:5432/database

# Docker initialization only; use a different password from MYSQL_PASSWORD.
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
